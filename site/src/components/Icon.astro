---
// Icone a tema scimmia, disegnate su viewBox 64×64: contorno scuro, pelo, muso, banana.
// Decorative (aria-hidden) di default; quelle di interfaccia usano currentColor per il tema scuro.
interface Props {
  name: "monkey" | "banana" | "ball" | "lens" | "clock" | "tail" | "moon" | "sun" | "chevron";
  /** specchia orizzontalmente (es. la freccia "indietro") */
  flip?: boolean;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 32, label, class: cls, flip = false } = Astro.props;
const a11y: Record<string, string> = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg viewBox="0 0 64 64" width={size} height={size} class:list={["icon", cls, { flip }]} {...a11y}>
  {
    name === "monkey" && (
      <>
        <g fill="#7a4a2a">
          <circle cx="11" cy="34" r="9" />
          <circle cx="53" cy="34" r="9" />
          <circle cx="32" cy="35" r="21" />
        </g>
        <g fill="#f0cfa0">
          <circle cx="11" cy="34" r="5" />
          <circle cx="53" cy="34" r="5" />
          <circle cx="25" cy="34" r="9" />
          <circle cx="39" cy="34" r="9" />
          <ellipse cx="32" cy="45" rx="14" ry="10.5" />
        </g>
        <g fill="#1e1a16">
          <circle cx="26" cy="33" r="3" />
          <circle cx="38" cy="33" r="3" />
          <ellipse cx="29.5" cy="41" rx="1.4" ry="1" />
          <ellipse cx="34.5" cy="41" rx="1.4" ry="1" />
        </g>
        <g fill="#fff">
          <circle cx="27" cy="32" r="1" />
          <circle cx="39" cy="32" r="1" />
        </g>
        <path d="M25 46 Q32 53 39 46" fill="none" stroke="#1e1a16" stroke-width="2.4" stroke-linecap="round" />
        <path
          d="M20 16 L21 5 L27 11 L32 3 L37 11 L43 5 L44 16 Z"
          fill="#f2c230"
          stroke="#b8860b"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    name === "banana" && (
      <>
        <path
          d="M12 14 C10 36 24 54 50 52 C54 52 56 49 53 47 C34 46 22 34 20 16 C19 11 13 10 12 14 Z"
          fill="#f2c230"
          stroke="#b8860b"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path d="M17 20 C19 34 28 44 44 48" fill="none" stroke="#d9a514" stroke-width="2" stroke-linecap="round" />
        <path d="M11 10 L15 8 L17 13 L13 15 Z" fill="#5b4a1f" />
      </>
    )
  }
  {
    name === "ball" && (
      <>
        <circle cx="14" cy="22" r="8" fill="#7a4a2a" stroke="#1e1a16" stroke-width="3" />
        <circle cx="14" cy="22" r="3.5" fill="#f0cfa0" />
        <circle cx="50" cy="22" r="8" fill="#7a4a2a" stroke="#1e1a16" stroke-width="3" />
        <circle cx="50" cy="22" r="3.5" fill="#f0cfa0" />
        <circle cx="32" cy="36" r="21" fill="#f2c230" stroke="#1e1a16" stroke-width="3" />
        <text x="32" y="44" text-anchor="middle" font-family="system-ui, Arial, sans-serif" font-weight="800" font-size="22" fill="#3d2f00">90</text>
      </>
    )
  }
  {
    name === "lens" && (
      <>
        <path
          d="M38 38 C46 44 52 44 54 50 C56 57 48 60 45 55 C43 52 47 49 49 52"
          fill="none"
          stroke="#7a4a2a"
          stroke-width="6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="26" cy="26" r="17" fill="#cde2fb" stroke="#1e1a16" stroke-width="4" />
        <path d="M17 22 Q20 15 28 14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
        <path d="M32 12 C30 6 36 3 40 6 C36 7 34 9 32 12 Z" fill="#1d5c3a" stroke="#1e1a16" stroke-width="2" stroke-linejoin="round" />
        <circle cx="32" cy="36" r="22" fill="#7a4a2a" stroke="#1e1a16" stroke-width="3" />
        <circle cx="32" cy="36" r="15" fill="#f0cfa0" />
        <path d="M32 36 V26 M32 36 L40 40" stroke="#1e1a16" stroke-width="4" stroke-linecap="round" />
        <circle cx="32" cy="36" r="2.5" fill="#1e1a16" />
      </>
    )
  }
  {
    name === "tail" && (
      <g fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 46 C6 44 6 34 14 34 C20 34 22 40 18 42" />
        <path d="M14 34 C24 22 40 22 52 32" />
        <path d="M40 22 L53 32.5 L41 43" />
      </g>
    )
  }
  {
    name === "moon" && (
      <>
        <path
          d="M40 8 C24 12 16 26 20 40 C24 52 38 58 52 52 C38 50 28 40 30 26 C31 18 35 12 40 8 Z"
          fill="#f2c230"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="round"
        />
        <path d="M40 8 L43 5 M52 52 L56 53" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
        <circle cx="48" cy="20" r="2.2" fill="currentColor" />
        <circle cx="54" cy="32" r="1.6" fill="currentColor" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <path
          d="M32 4 V11 M32 53 V60 M4 32 H11 M53 32 H60 M12 12 L17 17 M47 47 L52 52 M12 52 L17 47 M47 17 L52 12"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
        />
        <circle cx="20" cy="26" r="5.5" fill="#7a4a2a" stroke="currentColor" stroke-width="2.5" />
        <circle cx="44" cy="26" r="5.5" fill="#7a4a2a" stroke="currentColor" stroke-width="2.5" />
        <circle cx="32" cy="33" r="13" fill="#f2c230" stroke="currentColor" stroke-width="3.5" />
        <circle cx="27.5" cy="31" r="1.9" fill="#1e1a16" />
        <circle cx="36.5" cy="31" r="1.9" fill="#1e1a16" />
        <path d="M26.5 37 Q32 42 37.5 37" fill="none" stroke="#1e1a16" stroke-width="2.6" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "chevron" && (
      <>
        <path
          d="M24 14 C34 22 40 28 40 32 C40 36 34 42 24 50"
          fill="none"
          stroke="currentColor"
          stroke-width="7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="24" cy="14" r="5" fill="#f2c230" stroke="currentColor" stroke-width="3" />
      </>
    )
  }
</svg>

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
    flex: none;
  }
  .flip {
    transform: scaleX(-1);
  }
</style>
