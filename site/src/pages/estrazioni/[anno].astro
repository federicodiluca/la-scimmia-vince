---
import Icon from "../../components/Icon.astro";
import DrawBalls from "../../components/DrawBalls.astro";
import Layout from "../../layouts/Layout.astro";
import { drawPath, drawsOfYear, frequency, years } from "../../lib/data";
import { date, url, weekday } from "../../lib/format";

export function getStaticPaths() {
  return years.map((y) => ({ params: { anno: String(y) } }));
}

const year = Number(Astro.params.anno);
const list = [...drawsOfYear(year)].reverse();
const counts = Object.entries(frequency.by_year[String(year)] ?? {})
  .map(([n, c]) => ({ n: Number(n), c }))
  .sort((a, b) => b.c - a.c || a.n - b.n);
const idx = years.indexOf(year);
const prev = years[idx - 1];
const next = years[idx + 1];
---

<Layout
  title={`SuperEnalotto ${year}: tutte le estrazioni`}
  description={`Tutte le ${list.length} estrazioni del SuperEnalotto del ${year}: sestina vincente, jolly e superstar di ogni concorso, e i numeri più usciti dell'anno.`}
>
  <nav class="crumbs" aria-label="Percorso"><a href={url("estrazioni")}>Archivio</a> › {year}</nav>
  <h1>Estrazioni {year}</h1>
  <p class="lead">
    {list.length} concorsi. I più usciti dell'anno:
    {counts.slice(0, 3).map((x, i) => <>{i > 0 && ", "}<a href={url(`numeri/${x.n}`)}>{x.n}</a> ({x.c})</>)}. Il
    prossimo anno saranno altri, e nessuno se ne ricorderà.
  </p>

  <div class="card table-scroll">
    <table>
      <thead>
        <tr><th>Concorso</th><th>Data</th><th>Numeri · <span class="muted">jolly · superstar</span></th></tr>
      </thead>
      <tbody>
        {
          list.map((d) => (
            <tr>
              <td class="num">{Number(d.id.split("-")[1])}</td>
              <td>
                <a class="nowrap" href={url(drawPath(d))}>{date(d.date)}</a>
                <br />
                <small class="muted">{weekday(d.date)}</small>
              </td>
              <td>
                <DrawBalls draw={d} small />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <nav class="pager" aria-label="Altri anni">
    {prev ? <a href={url(`estrazioni/${prev}`)}><Icon name="arrow" size={20} flip /> {prev}</a> : <span></span>}
    {next ? <a href={url(`estrazioni/${next}`)}>{next} <Icon name="arrow" size={20} /></a> : <span></span>}
  </nav>
</Layout>

<style>
  .crumbs {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .nowrap {
    white-space: nowrap;
  }
  td {
    vertical-align: middle;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    margin-top: 24px;
  }
  /* telefoni: una riga della tabella diventa un blocco, data sopra e palline sotto a tutta larghezza */
  @media (max-width: 640px) {
    .card {
      padding: 4px 16px;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    table,
    tbody {
      display: block;
    }
    tr {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 6px 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--grid);
    }
    tr:last-child {
      border-bottom: 0;
    }
    td {
      display: block;
      padding: 0;
      border: 0;
    }
    td.num {
      text-align: left;
      color: var(--muted);
    }
    td.num::before {
      content: "n. ";
    }
    td br {
      display: none;
    }
    td small::before {
      content: " · ";
    }
    td:last-child {
      grid-column: 1 / -1;
    }
    td :global(.balls) {
      gap: 6px;
    }
  }
</style>
