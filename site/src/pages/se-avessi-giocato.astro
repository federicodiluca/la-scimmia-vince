---
import BalancePanel from "../components/BalancePanel.astro";
import Icon from "../components/Icon.astro";
import Verdict from "../components/Verdict.astro";
import Layout from "../layouts/Layout.astro";
import game from "../data/generated/game.json";
import { simulation as sim } from "../lib/data";
import { date, eur, eurShort, int, pct } from "../lib/format";
import type { Row } from "../lib/simulator";

const c = sim.curves;
const all = [...c.monkeys["5"], ...c.monkeys["95"], ...Object.values(c.strategies).flat()];
const pad = (Math.max(...all) - Math.min(...all)) * 0.06;
const domain: [number, number] = [Math.min(...all) - pad, Math.max(0, ...all) + pad];
const band = { low: c.monkeys["5"], mid: c.monkeys["50"], high: c.monkeys["95"] };
const medianReturn = sim.monkeys.returned["50"]!;
const firstYear = new Date(sim.first.date).getUTCFullYear();
const years = new Date(sim.last.date).getUTCFullYear() - firstYear;
// fuori dalla fascia 5°-95° percentile delle scimmie
const outside = sim.strategies.filter((s) => s.monkeys_better < sim.players * 0.05 || s.monkeys_better > sim.players * 0.95);
// la sestina del 6 più ricco: il senno di poi in un bottone
const rows = game.draws as unknown as Row[];
const record = rows.reduce((a, b) => (b[5][5]! > a[5][5]! ? b : a));
const client = JSON.stringify({
  monkeys: sim.monkeys.final_sorted,
  band,
  dates: c.dates,
  first: sim.first.date,
  last: sim.last.date,
});
---

<Layout
  ogImage="og/se-avessi-giocato.png"
  title="Quanto avresti vinto al SuperEnalotto con i tuoi numeri"
  description={`Scegli 6 numeri e scopri quanto avresti vinto, o perso, giocandoli al SuperEnalotto a ogni concorso dal ${firstYear}, con le quote vere. E come se la sono cavata ritardatari e numeri caldi contro ${int(sim.players)} scimmie.`}
>
  <h1>Se avessi giocato i tuoi numeri…</h1>
  <p class="lead">
    Scegli 6 numeri, magari quelli che giochi davvero, e scopri quanto avresti vinto o perso giocandoli a ogni concorso
    dal {date(sim.first.date)}: {int(sim.draws)} giocate, con le quote vere pagate ogni sera.
  </p>

  <form class="card picker" id="prova" data-sim={client}>
    <fieldset>
      <legend>I tuoi 6 numeri <span class="count" aria-live="polite">0/6</span></legend>
      <div class="pick-grid">
        {
          Array.from({ length: 90 }, (_, i) => i + 1).map((n) => (
            <button type="button" class="pick" data-n={n} aria-pressed="false">
              {n}
            </button>
          ))
        }
      </div>
    </fieldset>
    <div class="actions">
      <button type="button" class="btn random"><Icon name="monkey" size={22} /> Scegli come una scimmia</button>
      <button type="button" class="btn ghost preset" data-picks={record[2].join("-")}>
        I numeri del 6 da {eurShort(record[5][5]!)}
      </button>
      <button type="button" class="btn ghost clear">Azzera</button>
    </div>
    <p class="notice" hidden></p>
    <p class="muted privacy">Il calcolo avviene nel tuo browser: i numeri non vengono inviati da nessuna parte.</p>
  </form>

  <section class="outcome" aria-live="polite" aria-labelledby="outcome-title">
    <h2 id="outcome-title" class="visually-hidden">Il tuo risultato</h2>
    <div class="outcome-body">
      <p class="muted placeholder">Scegli 6 numeri per vedere com'è andata.</p>
    </div>
    <noscript><p class="muted">Il simulatore ha bisogno di JavaScript. Più sotto trovi comunque le strategie già calcolate.</p></noscript>
  </section>

  <h2>E le strategie "furbe"?</h2>
  <p class="prose">
    Una colonna a ogni concorso per {years} anni, {eur(sim.spent)} spesi. Cinque strategie da manuale del giocatore contro
    {int(sim.players)} scimmie che scelgono sei numeri a caso ogni volta. Ogni pannello è il saldo nel tempo di una strategia
    (la linea blu). La fascia grigia è dove finiscono 9 scimmie su 10, la linea grigia è la scimmia "media". Scende sempre:
    è quello che resta al giocatore dopo che il banco ha fatto il suo lavoro.
  </p>
  <div class="panels">
    {
      sim.strategies.map((s) => (
        <div class="card">
          <BalancePanel id={`p-${s.key}`} title={s.label} dates={c.dates} values={c.strategies[s.key]!} band={band} domain={domain} />
        </div>
      ))
    }
  </div>

  <div class="card table-scroll results">
    <table>
      <thead>
        <tr>
          <th>Strategia</th>
          <th class="num">Speso</th>
          <th class="num">Vinto</th>
          <th class="num">Recuperato</th>
          <th class="num">Vincita migliore</th>
          <th class="num">Scimmie che hanno fatto meglio</th>
        </tr>
      </thead>
      <tbody>
        {
          sim.strategies.map((s) => (
            <tr>
              <td>{s.label}</td>
              <td class="num">{eur(s.spent)}</td>
              <td class="num">{eur(s.won)}</td>
              <td class="num">{pct(s.returned)}</td>
              <td class="num">{s.best_win ? eur(s.best_win) : "–"}</td>
              <td class="num">{int(s.monkeys_better)} su {int(sim.players)}</td>
            </tr>
          ))
        }
        <tr class="monkey-row">
          <td><Icon name="monkey" size={20} /> La scimmia mediana</td>
          <td class="num">{eur(sim.spent)}</td>
          <td class="num">{eur(sim.spent * medianReturn)}</td>
          <td class="num">{pct(medianReturn)}</td>
          <td class="num">–</td>
          <td class="num">{int(sim.players / 2)} su {int(sim.players)}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <Verdict>
    <p>
      <strong>La scimmia dice:</strong>{" "}
      {
        outside.length === 0
          ? "nessuna strategia esce dalla fascia delle scimmie."
          : `${outside.map((s) => `"${s.label}"`).join(" e ")} ${outside.length === 1 ? "finisce" : "finiscono"} fuori dalla fascia, ma ${outside.every((s) => s.monkeys_better > sim.players / 2) ? "in basso: ha fatto peggio di quasi tutte le scimmie" : "per poco"}. Non è un segnale: con ${sim.strategies.length} strategie e una fascia che contiene 9 scimmie su 10, la probabilità che almeno una ne esca per puro caso è del ${pct(1 - 0.9 ** sim.strategies.length)}.`
      }{" "}
      La scimmia mediana recupera il {pct(medianReturn)} di quello che spende e solo {int(sim.monkeys.in_profit)} scimmie su{" "}
      {int(sim.players)} chiudono in attivo. Chi ci riesce ha avuto fortuna, non un metodo: la prossima volta toccherà a
      un'altra scimmia.
    </p>
  </Verdict>

  <p class="muted small">
    Regole della simulazione: una colonna a concorso con la sestina, jolly per il 5+1, niente superstar. Costo 0,50 €
    a colonna fino al {sim.price_change ? date(sim.price_change.date) : "cambio di regolamento"}, poi 1 € (quando è
    arrivato anche il premio per il 2). Vincite alle quote reali di ogni concorso, al lordo delle tasse: un'ipotesi
    generosa verso il giocatore. Se una giocata centra una categoria che quel giorno nessuno ha centrato (succede spesso
    con il 5+1) non c'è una quota reale da usare: la vincita viene indicata a parte, con il valore tipico della
    categoria, e resta fuori dal conto. Vale anche per le scimmie.
  </p>
</Layout>

<script>
  import game from "../data/generated/game.json";
  import { balanceChart } from "../lib/balance-chart";
  import { drawPath, url } from "../lib/format";
  import { parsePicks, simulate, TIERS, typicalPrize, type Outcome, type Row } from "../lib/simulator";

  const rows = game.draws as unknown as Row[];
  const eur = new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR", useGrouping: "always" });
  const eur0 = new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR", maximumFractionDigits: 0, useGrouping: "always" });
  const intf = new Intl.NumberFormat("it-IT", { useGrouping: "always" });
  const cents = new Intl.NumberFormat("it-IT", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dateFmt = new Intl.DateTimeFormat("it-IT", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  const day = (iso: string) => dateFmt.format(new Date(`${iso}T00:00:00Z`));
  const signed = (v: number) => `${v < 0 ? "−" : "+"}${eur0.format(Math.abs(v))}`;

  const form = document.querySelector<HTMLFormElement>(".picker")!;
  const data: {
    monkeys: number[];
    band: { low: number[]; mid: number[]; high: number[] };
    dates: string[];
    first: string;
    last: string;
  } = JSON.parse(form.dataset.sim!);
  const body = document.querySelector<HTMLDivElement>(".outcome-body")!;
  const notice = form.querySelector<HTMLParagraphElement>(".notice")!;
  const count = form.querySelector(".count")!;
  const buttons = [...form.querySelectorAll<HTMLButtonElement>(".pick")];
  const chosen = new Set<number>();
  // indici dei concorsi campionati nelle curve delle scimmie
  const rowOf = new Map(rows.map((r, i) => [r[1], i]));
  const sampled = data.dates.map((d) => rowOf.get(d)!);
  const typical = TIERS.map((_, t) => typicalPrize(rows, t));
  const medianMonkey = data.monkeys[data.monkeys.length >> 1]!;

  function tierLabel(t: number) {
    return t === 4 ? "5+1" : `${TIERS[t]}`;
  }

  function monkeyLine(r: Outcome) {
    const net = Math.round(r.net);
    const beaten = data.monkeys.filter((m) => m < net).length;
    const n = data.monkeys.length;
    const comment =
      r.best?.tier === 5
        ? `Col senno di poi è facile: il ${day(r.best.date)} nessuno sapeva che sarebbero usciti proprio questi.`
        : beaten > n * 0.95
          ? "Complimenti alla fortuna: la prossima volta toccherà a un'altra scimmia."
          : beaten < n * 0.05
            ? "La scimmia ringrazia."
            : "Esattamente come una scimmia qualsiasi.";
    return `<p class="monkeys"><strong>Hai fatto meglio di ${intf.format(beaten)} scimmie su ${intf.format(n)}</strong>
      che hanno giocato 6 numeri a caso a ogni concorso (la scimmia mediana: ${signed(medianMonkey)}). ${comment}</p>`;
  }

  function renderOutcome(r: Outcome) {
    const perEuro = r.won / r.spent;
    const tierRows = TIERS.map((_, t) => t)
      .reverse()
      .map((t) => {
        const x = r.byTier[t]!;
        const paid = x.hits - x.unknown;
        return `<tr${x.hits ? "" : ' class="none"'}>
          <td>Punti ${tierLabel(t)}${t === 0 ? ' <span class="muted">(dal 2017)</span>' : ""}</td>
          <td class="num">${x.hits ? intf.format(x.hits) : "–"}</td>
          <td class="num">${paid ? eur.format(x.amount) : x.unknown ? "quota ignota" : "–"}</td>
        </tr>`;
      })
      .join("");
    const unknown = r.unknown.length
      ? `<div class="unknown">
          <p><strong>${r.unknown.length === 1 ? "Una vincita senza quota" : `${r.unknown.length} vincite senza quota`}.</strong>
          ${r.unknown.length === 1 ? "In questo concorso" : "In questi concorsi"} nessuno ha centrato la categoria, quindi non esiste una quota
          da usare e ${r.unknown.length === 1 ? "la vincita resta" : "le vincite restano"} fuori dal conto:</p>
          <ul>${r.unknown
            .map(
              (w) =>
                `<li><a href="${url(drawPath(w))}">${day(w.date)}</a>: punti ${tierLabel(w.tier)}. Di solito vale circa ${eur0.format(typical[w.tier]!)}.</li>`,
            )
            .join("")}</ul>
        </div>`
      : "";
    const best = r.best
      ? `<p>La vincita più alta: <strong>${eur.format(r.best.amount!)}</strong> con il ${tierLabel(r.best.tier)}, il
          <a href="${url(drawPath(r.best))}">${day(r.best.date)}</a>.</p>`
      : "<p>Nemmeno un 2 in tutti questi anni. Succede.</p>";

    body.innerHTML = `
      <div class="card result">
        <p class="kicker">${r.picks.map((n) => `<span class="ball sm">${n}</span>`).join("")}</p>
        <p class="big ${r.net < 0 ? "loss" : "gain"}">${signed(r.net)}</p>
        <p class="sub">Dal ${day(data.first)} al ${day(data.last)} avresti speso <strong>${eur.format(r.spent)}</strong>
          e vinto <strong>${eur.format(r.won)}</strong>. Ogni euro giocato te ne avrebbe restituiti
          <strong>${cents.format(perEuro)}</strong>.</p>
        <div class="result-grid">
          <figure class="chart">
            <figcaption>Il saldo nel tempo, contro ${intf.format(data.monkeys.length)} scimmie</figcaption>
            <div class="chart-box"></div>
            <p class="legend"><span><span class="key you"></span> i tuoi numeri</span>
              <span><span class="key mid"></span> scimmia mediana</span>
              <span><span class="key band"></span> 9 scimmie su 10</span></p>
          </figure>
          <div>
            <table class="tiers">
              <thead><tr><th>Categoria</th><th class="num">Volte</th><th class="num">Vinto</th></tr></thead>
              <tbody>${tierRows}</tbody>
            </table>
            ${best}
          </div>
        </div>
        ${unknown}
        ${monkeyLine(r)}
        <div class="share">
          <button type="button" class="btn share-btn">Condividi il risultato</button>
          <span class="share-status muted" role="status"></span>
        </div>
        <p class="help-link muted">Giochi davvero e questi conti ti preoccupano?
          <a href="${url("smettere-di-giocare")}">Qui trovi aiuto, gratis e in anonimato</a>.</p>
      </div>`;
    body.querySelector(".share-btn")!.addEventListener("click", () => share(r));
    last = r;
    drawChart();
  }

  // il grafico si ridisegna alla larghezza reale del suo riquadro
  let last: Outcome | null = null;
  function drawChart() {
    const box = body.querySelector<HTMLDivElement>(".chart-box");
    if (!box || !last) return;
    box.innerHTML = balanceChart({
      dates: data.dates,
      values: sampled.map((i) => last!.balance[i]!),
      band: data.band,
      label: `Saldo di ${last.picks.join(" ")}`,
      width: box.clientWidth,
    });
  }
  let resizing = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(resizing);
    resizing = requestAnimationFrame(drawChart);
  });

  async function share(r: Outcome) {
    const status = body.querySelector(".share-status")!;
    const verb = r.net < 0 ? `avrei perso ${eur0.format(-r.net)}` : `avrei guadagnato ${eur0.format(r.net)}`;
    const text = `Giocando ${r.picks.join(" ")} a ogni concorso dal ${new Date(data.first).getUTCFullYear()} ${verb}. E tu?`;
    const link = location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: "Se avessi giocato i miei numeri…", text, url: link });
        return;
      }
      await navigator.clipboard.writeText(`${text} ${link}`);
      status.textContent = "Link copiato.";
    } catch (e) {
      if ((e as Error).name !== "AbortError") status.textContent = `Copia questo link: ${link}`;
    }
  }

  function render() {
    count.textContent = `${chosen.size}/6`;
    for (const b of buttons) {
      const on = chosen.has(Number(b.dataset.n));
      b.setAttribute("aria-pressed", String(on));
      b.disabled = !on && chosen.size >= 6;
    }
    const picks = [...chosen].sort((a, b) => a - b);
    history.replaceState(null, "", picks.length === 6 ? `?n=${picks.join("-")}` : location.pathname);
    if (picks.length < 6) {
      const left = 6 - picks.length;
      last = null;
      body.innerHTML = `<p class="muted placeholder">${
        picks.length ? `Scegli ancora ${left} ${left === 1 ? "numero" : "numeri"}.` : "Scegli 6 numeri per vedere com'è andata."
      }</p>`;
      return;
    }
    renderOutcome(simulate(rows, picks));
  }

  function setPicks(picks: number[]) {
    chosen.clear();
    for (const n of picks) chosen.add(n);
    notice.hidden = true;
    render();
  }

  for (const b of buttons) {
    b.addEventListener("click", () => {
      const n = Number(b.dataset.n);
      if (chosen.has(n)) chosen.delete(n);
      else if (chosen.size < 6) chosen.add(n);
      notice.hidden = true;
      render();
    });
  }
  form.querySelector(".random")!.addEventListener("click", () => {
    const picks = new Set<number>();
    while (picks.size < 6) picks.add(1 + Math.floor(Math.random() * 90));
    setPicks([...picks]);
  });
  form.querySelector<HTMLButtonElement>(".preset")!.addEventListener("click", (e) => {
    setPicks((e.currentTarget as HTMLButtonElement).dataset.picks!.split("-").map(Number));
  });
  form.querySelector(".clear")!.addEventListener("click", () => setPicks([]));

  // numeri dal link condiviso o dal form della home
  const fromUrl = parsePicks(location.search);
  setPicks(fromUrl.picks);
  if (fromUrl.invalid) {
    notice.hidden = false;
    notice.textContent = `Nel link c'erano numeri non validi o ripetuti: servono 6 numeri diversi da 1 a 90. ${
      fromUrl.picks.length ? "Abbiamo tenuto quelli buoni, completa tu la sestina." : ""
    }`;
  }
  if (fromUrl.picks.length === 6) document.querySelector(".outcome")!.scrollIntoView({ block: "start" });
</script>

<style>
  .picker {
    margin-top: 24px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    font-weight: 650;
    margin-bottom: 10px;
  }
  .count {
    color: var(--ink-2);
    font-weight: 400;
    margin-left: 8px;
    font-variant-numeric: tabular-nums;
  }
  .pick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(42px, 1fr));
    gap: 6px;
  }
  .pick {
    min-height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--ink);
    font: inherit;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .pick[aria-pressed="true"] {
    background: var(--banana);
    color: var(--banana-ink);
    border-color: #b8860b;
  }
  .pick:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 16px 0 8px;
  }
  .notice {
    background: color-mix(in srgb, var(--neg) 12%, transparent);
    border-radius: 10px;
    padding: 8px 12px;
  }
  .privacy {
    font-size: 0.9rem;
    margin: 8px 0 0;
  }

  .outcome {
    margin-top: 16px;
    scroll-margin-top: 16px;
  }
  .placeholder {
    text-align: center;
    padding: 12px 0;
  }
  .outcome :global(.result .kicker) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 8px;
  }
  .outcome :global(.big) {
    font-size: clamp(2.6rem, 9vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    margin: 0 0 8px;
  }
  .outcome :global(.big.loss) {
    color: var(--neg);
  }
  .outcome :global(.big.gain) {
    color: var(--brand);
  }
  .outcome :global(.sub) {
    font-size: 1.1rem;
    max-width: 62ch;
  }
  .outcome :global(.result-grid) {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 24px;
    align-items: start;
    margin: 20px 0 8px;
  }
  @media (max-width: 760px) {
    .outcome :global(.result-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .outcome :global(.chart) {
    margin: 0;
  }
  .outcome :global(.chart figcaption) {
    font-weight: 650;
    margin-bottom: 4px;
  }
  .outcome :global(.chart svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .outcome :global(.chart .grid) {
    stroke: var(--grid);
  }
  .outcome :global(.chart .zero) {
    stroke: var(--axis);
  }
  .outcome :global(.chart .tick) {
    fill: var(--muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .outcome :global(.chart .band) {
    fill: var(--band);
  }
  .outcome :global(.chart .mid) {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .outcome :global(.chart .series) {
    fill: none;
    stroke: var(--series-1);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .outcome :global(.chart .end) {
    fill: var(--series-1);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .outcome :global(.chart .hit) {
    fill: transparent;
  }
  .outcome :global(.chart .hit:hover) {
    fill: color-mix(in srgb, var(--series-1) 8%, transparent);
  }
  .outcome :global(.legend) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    color: var(--ink-2);
    font-size: 0.85rem;
    margin: 6px 0 0;
  }
  .outcome :global(.legend > span) {
    white-space: nowrap;
  }
  .outcome :global(.key) {
    display: inline-block;
    width: 16px;
    height: 10px;
    border-radius: 3px;
    margin-left: 6px;
  }
  .outcome :global(.key.you) {
    background: var(--series-1);
    height: 3px;
  }
  .outcome :global(.key.mid) {
    background: var(--muted);
    height: 3px;
  }
  .outcome :global(.key.band) {
    background: var(--band);
    box-shadow: inset 0 0 0 1px var(--axis);
  }
  .outcome :global(.tiers) {
    margin-bottom: 12px;
  }
  .outcome :global(.tiers tr.none td) {
    color: var(--muted);
  }
  .outcome :global(.unknown) {
    background: var(--surface-2);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 8px 0 16px;
  }
  .outcome :global(.unknown ul) {
    margin: 0;
    padding-left: 1.2em;
  }
  .outcome :global(.monkeys) {
    border-top: 1px solid var(--border);
    padding-top: 14px;
  }
  .outcome :global(.help-link) {
    font-size: 0.95rem;
    margin: 16px 0 0;
  }
