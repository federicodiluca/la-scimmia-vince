---
import DrawBalls from "../components/DrawBalls.astro";
import FrequencyChart from "../components/FrequencyChart.astro";
import Icon from "../components/Icon.astro";
import Verdict from "../components/Verdict.astro";
import Layout from "../layouts/Layout.astro";
import { drawPath, frequency, honesty, simulation, summary } from "../lib/data";
import { date, dec, eur, eurShort, il, int, pct, url, weekday } from "../lib/format";

const last = summary.last_draw;
const band = frequency.band;
const fakes = honesty.fake_discoveries;
const naive = fakes.naive_discoveries;
const expectedFakes = fakes.expected_false_positives;
const survivors = fakes.survivors_after_correction;
const tests = fakes.tests;
const late = honesty.delay_fallacy.filter((b) => ["75-99", "100-149", "150+"].includes(b.delay));
const lateHits = late.reduce((s, b) => s + b.hits, 0);
const lateOpp = late.reduce((s, b) => s + b.opportunities, 0);
const years = new Date(summary.last_draw.date).getUTCFullYear() - new Date(summary.first_date).getUTCFullYear();
const jackpot = summary.jackpot;
const same = simulation.strategies.find((s) => s.key === "sempre_uguali");
const simYear = new Date(simulation.first.date).getUTCFullYear();

const sections = [
  { href: url("se-avessi-giocato"), icon: "banana", title: "Se avessi giocato…", text: "Ritardatari, numeri caldi, sempre gli stessi: quanto avresti vinto dal 2009 con le quote vere? E con i tuoi numeri?" },
  { href: url("numeri"), icon: "ball", title: "I 90 numeri", text: "Uscite, ritardi e compagni di sestina di ogni numero. Con il confronto che gli altri non fanno: quanto ci si aspettava per caso." },
  { href: url("ritardatari"), icon: "clock", title: "Il mito del ritardatario", text: "Un numero che non esce da 100 estrazioni è \"maturo\"? Lo abbiamo verificato su tutte le estrazioni." },
  { href: url("correlazioni"), icon: "lens", title: "Correlazioni assurde", text: "Il 17 esce di più il martedì? A cercare bene si trova sempre qualcosa. Ecco perché non conta." },
] as const;
---

<Layout
  title="La Scimmia Vince"
  description={`Statistiche oneste sul SuperEnalotto: ${int(summary.draws)} estrazioni dal 1997 analizzate. Numeri caldi, freddi e ritardatari messi alla prova: il caso non ha memoria.`}
>
  <section class="hero">
    <div>
      <p class="kicker">SuperEnalotto · {int(summary.draws)} estrazioni in {years} anni</p>
      <h1>Il caso non ha memoria.<br />La scimmia lo sa.</h1>
      <p class="lead">
        Numeri caldi, freddi, ritardatari, "sistemi": abbiamo messo alla prova tutte le estrazioni del SuperEnalotto
        dal 1997 a oggi. Una scimmia che sceglie sei numeri a caso fa esattamente come chi segue le strategie. Né
        meglio né peggio.
      </p>
    </div>
    <Icon name="monkey" size={180} class="hero-monkey" />
  </section>

  <section class="card try" aria-labelledby="try-title">
    <div class="try-text">
      <h2 id="try-title">E se avessi giocato i tuoi numeri?</h2>
      <p>
        Scrivi i 6 numeri che giochi, o che giocheresti: ti diciamo quanto avresti vinto, o perso, giocandoli a ogni
        concorso dal {simYear}. Con le quote vere.
      </p>
      {
        same && (
          <p class="muted">
            Chi ha giocato sempre 1 2 3 4 5 6 ha speso {eur(same.spent)} e ne ha ripresi {eur(same.won)}.
          </p>
        )
      }
    </div>
    <form class="try-form" action={url("se-avessi-giocato")} method="get">
      <fieldset>
        <legend class="visually-hidden">I tuoi 6 numeri, da 1 a 90</legend>
        <div class="try-inputs">
          {
            Array.from({ length: 6 }, (_, i) => (
              <input
                type="number"
                name="n"
                min="1"
                max="90"
                step="1"
                inputmode="numeric"
                enterkeyhint={i < 5 ? "next" : "go"}
                autocomplete="off"
                required
                aria-label={`Numero ${i + 1}`}
                placeholder="·"
              />
            ))
          }
        </div>
      </fieldset>
      <div class="try-actions">
        <button class="btn banana" type="submit">
          <Icon name="banana" size={22} /> Scopri com'è andata
        </button>
        <button class="btn ghost try-random" type="button">
          <Icon name="monkey" size={22} /> A caso
        </button>
      </div>
      <a class="grid-link" href={`${url("se-avessi-giocato")}#prova`}>Preferisci toccarli? Scegli sulla griglia</a>
    </form>
  </section>

  <section class="card last" aria-labelledby="last-title">
    <div>
      <h2 id="last-title">Ultima estrazione</h2>
      <p class="muted">
        Concorso n. {Number(last.id.split("-")[1])} di{" "}
        <a href={url(drawPath(last))}>{weekday(last.date)} {date(last.date)}</a>
      </p>
      <DrawBalls draw={last} />
    </div>
    {
      jackpot?.pool_total_eur && jackpot.draw_id === last.id && (
        <div class="tile jackpot">
          <div class="label">Montepremi del concorso</div>
          <div class="value">{eurShort(jackpot.pool_total_eur)}</div>
          {jackpot.last_six && (
            <p class="note">
              {`Ultimo "6": ${date(jackpot.last_six.date)}, ${int(jackpot.last_six.draws_since)} estrazioni fa (${eur(jackpot.last_six.amount_eur)}).`}
            </p>
          )}
        </div>
      )
    }
  </section>

  <h2>Tre cose che i siti di pronostici non ti dicono</h2>
  <div class="grid grid-3">
    <div class="card tile">
      <div class="label">Numeri "caldi" o "freddi" davvero anomali</div>
      <div class="value">{band.outside} su 90</div>
      <p class="note">Per puro caso ce ne aspettavamo circa {dec(90 * (1 - band.confidence), 1)}. Cioè: nessuna anomalia.</p>
    </div>
    <div class="card tile">
      <div class="label">"Scoperte" tipo "l'81 esce di più il sabato"</div>
      <div class="value">{int(naive)} <Icon name="arrow" size={30} label="diventano" /> {survivors}</div>
      <p class="note">
        Su {int(tests)} confronti ce ne aspettavamo {int(Math.round(expectedFakes))} per caso. Dopo la verifica statistica{" "}
        {survivors === 0 ? "non ne resta nessuna" : survivors === 1 ? "ne resta una" : `ne restano ${survivors}`}.
      </p>
    </div>
    <div class="card tile">
      <div class="label">Un ritardatario (75+ estrazioni) esce</div>
      <div class="value">{pct(lateHits / lateOpp)}</div>
      <p class="note">delle volte. Un numero qualsiasi: {pct(6 / 90)}. Il ritardo non conta.</p>
    </div>
  </div>

  <h2>Numeri caldi e freddi? Rumore.</h2>
  <p class="prose">
    Ogni barra è un numero: quanto è uscito più (o meno) di quanto ci si aspetta in {int(summary.draws)} estrazioni,
    cioè circa {dec(band.expected, 0)} volte. La fascia grigia è dove cade un numero nel {Math.round(band.confidence * 100)}%
    dei casi <em>anche con un'urna perfettamente onesta</em>. Tocca una barra per aprire la scheda del numero.
  </p>
  <div class="card"><FrequencyChart counts={frequency.numbers} band={band} /></div>

  <Verdict>
    <p>
      <strong>La scimmia dice:</strong> {il(honesty.uniformity.numbers.most)} è il numero uscito di più
      ({int(honesty.uniformity.numbers.most_count)} volte), {il(honesty.uniformity.numbers.least)} quello uscito di meno
      ({int(honesty.uniformity.numbers.least_count)}). Sembra tanta differenza, ma il test del chi-quadro dà p = {dec(honesty.uniformity.numbers.p_value, 2)}:
      è esattamente la varietà che produce il caso. Giocare {il(honesty.uniformity.numbers.most)} non aumenta le tue probabilità.
    </p>
  </Verdict>

  <h2>Da dove cominciare</h2>
  <div class="grid grid-2">
    {
      sections.map((s) => (
        <a class="card section-link" href={s.href}>
          <Icon name={s.icon} size={44} />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </a>
      ))
    }
  </div>

  <section class="card odds">
    <Icon name="banana" size={56} />
    <div>
      <h2>La probabilità di fare 6</h2>
      <p class="odds-value">1 su 622.614.630</p>
      <p class="muted">
        È come indovinare un preciso secondo in un periodo di quasi 20 anni. Ogni estrazione, ogni combinazione: sempre la
        stessa probabilità, qualunque cosa sia uscita prima.
      </p>
      <p class="help-link">
        Il gioco sta diventando un problema, per te o per qualcuno vicino?
        <a href={url("smettere-di-giocare")}>Ecco da dove cominciare per smettere</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  const tryForm = document.querySelector<HTMLFormElement>(".try-form")!;
  const inputs = [...tryForm.querySelectorAll<HTMLInputElement>(".try-inputs input")];

  // numeri ripetuti: il browser controlla solo 1-90, i doppioni li segnaliamo noi
  function checkDuplicates() {
    for (const el of inputs) {
      const dup = el.value !== "" && inputs.some((o) => o !== el && o.value !== "" && Number(o.value) === Number(el.value));
      el.setCustomValidity(dup ? "Questo numero c'è già: servono 6 numeri diversi." : "");
    }
  }
  function fill(numbers: number[]) {
    inputs.forEach((el, i) => (el.value = numbers[i] ? String(numbers[i]) : ""));
    checkDuplicates();
  }

  inputs.forEach((input, i) => {
    const next = inputs[i + 1];
    input.addEventListener("input", () => {
      checkDuplicates();
      // due cifre scritte: si passa alla casella dopo
      if (input.value.length >= 2 && input.validity.valid && next && next.value === "") next.focus();
    });
    input.addEventListener("keydown", (e) => {
      // "Avanti"/Invio della tastiera del telefono: casella dopo, e dall'ultima si invia
      if (e.key === "Enter" && next) {
        e.preventDefault();
        next.focus();
      }
      if (e.key === "Backspace" && input.value === "" && i > 0) {
        e.preventDefault();
        inputs[i - 1]!.focus();
      }
    });
    // incollare "7 13 22 45 68 81" riempie tutte le caselle
    input.addEventListener("paste", (e) => {
      const found = (e.clipboardData?.getData("text") ?? "").match(/\d+/g)?.map(Number) ?? [];
      if (found.length < 2) return;
      e.preventDefault();
      fill(found.slice(0, 6));
    });
  });

  tryForm.querySelector(".try-random")!.addEventListener("click", () => {
    const picks = new Set<number>();
    while (picks.size < 6) picks.add(1 + Math.floor(Math.random() * 90));
    fill([...picks].sort((a, b) => a - b));
    tryForm.querySelector<HTMLButtonElement>("[type=submit]")!.focus();
  });
</script>

<style>
  .try {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 32px;
    align-items: center;
    border: 2px solid var(--banana);
    margin-bottom: 32px;
  }
  .try h2 {
    margin: 0 0 0.5rem;
  }
  .try-text p:last-child {
    margin: 0;
  }
  .try-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .try-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .try-inputs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 52px));
    gap: 6px;
  }
  .try-inputs input {
    width: 100%;
    aspect-ratio: 1;
    min-width: 0;
    font-size: 1.1rem;
    box-sizing: border-box;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    padding: 0;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .try-inputs input::-webkit-outer-spin-button,
  .try-inputs input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .try-inputs input:not(:placeholder-shown) {
    background: var(--banana);
    color: var(--banana-ink);
    border-color: #b8860b;
  }
  .try-inputs input:not(:placeholder-shown):invalid {
    background: color-mix(in srgb, var(--neg) 18%, var(--surface-2));
    color: var(--ink);
    border-color: var(--neg);
  }
  .try-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .grid-link {
    font-size: 0.95rem;
    padding: 4px 0;
  }
  /* telefoni: il form prende tutta la larghezza, le caselle si dividono lo spazio e non escono mai dal bordo */
  @media (max-width: 760px) {
    .try {
      grid-template-columns: minmax(0, 1fr);
      padding: 16px;
    }
    .try-form {
      align-items: stretch;
    }
    .try-inputs {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      max-width: 360px;
    }
    /* i bottoni non vanno mai a capo: se non c'è spazio si impilano a tutta larghezza */
    .try-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
      white-space: nowrap;
    }
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    margin: 8px 0 32px;
  }
  .kicker {
    color: var(--ink-2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }
  :global(.hero-monkey) {
    width: clamp(110px, 18vw, 180px);
    height: auto;
    transform: rotate(-6deg);
  }
  /* telefoni: la scimmia piccola accanto al titolo, così il simulatore resta nel primo schermo */
  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 12px;
      margin-bottom: 24px;
    }
    .hero > div {
      display: contents;
    }
    .kicker {
      grid-column: 1 / -1;
    }
    :global(.hero-monkey) {
      grid-column: 2;
      grid-row: 2;
      width: 72px;
    }
    .hero h1 {
      grid-column: 1;
      grid-row: 2;
    }
    .hero .lead {
      grid-column: 1 / -1;
      font-size: 1.05rem;
    }
  }
  .last {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
  }
  .last h2 {
    margin-top: 0;
    margin-bottom: 0.25rem;
  }
  .jackpot {
    min-width: 220px;
  }
  .section-link {
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.12s;
  }
  .section-link:hover {
    transform: translateY(-2px);
    border-color: var(--banana);
  }
  .section-link h3 {
    margin-top: 10px;
  }
  .section-link p {
    color: var(--ink-2);
    margin: 0;
  }
  .odds {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-top: 40px;
  }
  .odds h2 {
    margin: 0;
  }
  .help-link {
    margin: 0;
  }
  .odds-value {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 750;
    margin: 4px 0 8px;
  }
</style>
