---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { summary } from "../lib/data";
import { date, int, url } from "../lib/format";

interface Props {
  title: string;
  description: string;
  /** JSON-LD aggiuntivo specifico della pagina */
  jsonLd?: Record<string, unknown>;
  /** card Open Graph, relativa al sito (es. "og/numeri/17.png") */
  ogImage?: string;
  /** pagine da non indicizzare (es. la 404) */
  noindex?: boolean;
}

const { title, description, jsonLd, ogImage: og = "og/home.png", noindex = false } = Astro.props;
const SITE_NAME = "La Scimmia Vince";
const AUTHOR = {
  "@type": "Person",
  name: "Federico Di Luca",
  url: "https://federicodiluca.com/",
  sameAs: ["https://github.com/federicodiluca"],
};
// Google tronca oltre ~65 caratteri e mostra comunque il nome del sito: il suffisso solo se c'è spazio
const suffix = ` · ${SITE_NAME}`;
const fullTitle =
  title === SITE_NAME
    ? `${SITE_NAME} · il caso non ha memoria`
    : title.length + suffix.length <= 65
      ? `${title}${suffix}`
      : title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(og), Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: url("se-avessi-giocato"), label: "Se avessi giocato" },
  { href: url("numeri"), label: "Numeri" },
  { href: url("ritardatari"), label: "Ritardatari" },
  { href: url("correlazioni"), label: "Correlazioni" },
  { href: url("estrazioni"), label: "Archivio" },
  { href: url("metodo"), label: "Metodo" },
];
// staccata dalle altre: non è una sezione di statistiche, è per chi vuole smettere
const help = { href: url("smettere-di-giocare"), label: "Smettere di giocare", long: "Vuoi smettere di giocare?" };

const graph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: new URL(url(), Astro.site).href,
    inLanguage: "it-IT",
    description: "Statistiche oneste e ironiche sulle estrazioni del SuperEnalotto dal 1997 a oggi.",
    author: AUTHOR,
    creator: AUTHOR,
  },
  ...(jsonLd ? [{ "@context": "https://schema.org", ...jsonLd }] : []),
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Federico Di Luca" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("icons/icon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url("icons/icon-180.png")} />
    <link rel="manifest" href={url("manifest.webmanifest")} />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <meta name="theme-color" content="#f2c230" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={url()} aria-label="La Scimmia Vince, home">
          <Icon name="monkey" size={40} />
          <span>La Scimmia <strong>Vince</strong></span>
        </a>
        <nav id="site-nav" aria-label="Principale">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="help">
              <a href={help.href} aria-current={path.startsWith(help.href) ? "page" : undefined}>
                <span class="short">{help.label}</span>
                <span class="long">{help.long}</span>
              </a>
            </li>
          </ul>
        </nav>
        <button class="theme" type="button" aria-label="Cambia tema chiaro/scuro" title="Tema chiaro/scuro">
          <Icon name="moon" size={22} class="to-dark" />
          <Icon name="sun" size={24} class="to-light" />
        </button>
        <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path class="bars" d="M4 7h16M4 12h16M4 17h16" />
            <path class="cross" d="M6 6l12 12M18 6L6 18" />
          </svg>
          <span>Menu</span>
        </button>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <Icon name="banana" size={22} />{" "}
          {`Dati aggiornati al concorso del ${date(summary.last_draw.date)} · ${int(summary.draws)} estrazioni dal ${date(summary.first_date)}. `}
          Fonte: <a href="https://www.superenalotto.it/archivio-estrazioni" rel="noopener">archivio ufficiale</a>.
        </p>
        <p class="responsible">
          <strong>Il gioco è vietato ai minori e può causare dipendenza patologica.</strong>{" "}
          Questo sito non vende giocate e non ha legami con operatori di gioco. Se il gioco sta diventando un
          problema: Telefono Verde Nazionale dell'Istituto Superiore di Sanità{" "}
          <a href="tel:800558822">800 55 88 22</a>, anonimo e gratuito, dal lunedì al venerdì dalle 10 alle 16.
          <a href={url("smettere-di-giocare")}>Vuoi smettere di giocare? Da dove cominciare.</a>
        </p>
        <p class="credits">
          <Icon name="monkey" size={28} />
          <span>
            Un progetto di <a href="https://federicodiluca.com/" rel="author">Federico Di Luca</a>, indipendente e open
            source · <a href="https://federicodiluca.com/progetti/">guarda i miei altri progetti</a> ·{" "}
            <a href="https://github.com/federicodiluca/la-scimmia-vince">codice e dati su GitHub</a>
          </span>
        </p>
        <p class="muted">SuperEnalotto è un marchio registrato dei rispettivi titolari.</p>
      </div>
    </footer>

    <div class="viz-tip" role="status" aria-live="polite"></div>

    <script>
      // cambio tema, ricordato solo in questo browser
      const btn = document.querySelector<HTMLButtonElement>(".theme");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === "dark" ||
          (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
      });

      // menu su schermi stretti: si apre con il bottone, si chiude con Esc o toccando fuori
      const menu = document.querySelector<HTMLButtonElement>(".menu")!;
      const setMenu = (open: boolean) => {
        menu.setAttribute("aria-expanded", String(open));
        document.documentElement.classList.toggle("menu-open", open);
      };
      menu.addEventListener("click", () => setMenu(menu.getAttribute("aria-expanded") !== "true"));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu.getAttribute("aria-expanded") === "true") {
          setMenu(false);
          menu.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (!(e.target as Element).closest(".site-header")) setMenu(false);
      });

      // tooltip dei grafici: qualsiasi elemento con data-tip, al passaggio o al focus
      const tip = document.querySelector<HTMLDivElement>(".viz-tip")!;
      const show = (el: Element, x: number, y: number) => {
        tip.textContent = el.getAttribute("data-tip");
        const w = tip.offsetWidth;
        tip.style.left = `${Math.min(Math.max(8, x - w / 2), innerWidth - w - 8)}px`;
        tip.style.top = `${Math.max(8, y - tip.offsetHeight - 12)}px`;
        tip.classList.add("on");
      };
      const hide = () => tip.classList.remove("on");
      document.addEventListener("pointerover", (e) => {
        const el = (e.target as Element).closest("[data-tip]");
        if (el) show(el, e.clientX, e.clientY);
      });
      document.addEventListener("pointermove", (e) => {
        const el = (e.target as Element).closest("[data-tip]");
        if (el) show(el, e.clientX, e.clientY);
        else hide();
      });
      document.addEventListener("focusin", (e) => {
        const el = (e.target as Element).closest("[data-tip]");
        if (!el) return hide();
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener("focusout", hide);
      document.addEventListener("scroll", hide, { passive: true });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 10;
    background: var(--surface);
    padding: 8px 12px;
  }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    margin-bottom: 32px;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.15rem;
    white-space: nowrap;
  }
  .logo strong {
    font-weight: 850;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 550;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--banana);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .help {
    border-left: 1px solid var(--border);
    padding-left: 18px;
  }
  .help a {
    color: var(--brand);
  }
  .help .long {
    display: none;
  }
  .theme :global(.to-light) {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme :global(.to-light) {
    display: inline-block;
  }
  :global(:root[data-theme="dark"]) .theme :global(.to-dark) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme :global(.to-light) {
      display: inline-block;
    }
    :global(:root:not([data-theme="light"])) .theme :global(.to-dark) {
      display: none;
    }
  }
  .theme {
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-2);
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .menu {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px 0 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .menu path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .menu .cross,
  .menu[aria-expanded="true"] .bars {
    display: none;
  }
  .menu[aria-expanded="true"] .cross {
    display: inline;
  }
  /* sotto i 1100px la barra non ci sta su una riga (ne servono ~1060, più margine per i font di Mac e Android) */
  @media (max-width: 1100px) {
    .bar {
      gap: 10px;
      min-height: 60px;
    }
    .theme {
      margin-left: auto;
      width: 40px;
      height: 40px;
    }
    nav {
      order: 3;
      margin-left: 0;
      width: 100%;
    }
    nav ul {
      flex-direction: column;
      gap: 0;
      padding-bottom: 8px;
    }
    nav li + li {
      border-top: 1px solid var(--border);
    }
    nav li.help {
      border-left: 0;
      border-top: 2px solid var(--border);
      margin-top: 6px;
      padding-left: 0;
    }
    .help .short {
      display: none;
    }
    .help .long {
      display: inline;
    }
    nav a {
      display: block;
      padding: 12px 4px;
      font-size: 1.05rem;
    }
    nav a[aria-current="page"] {
      text-decoration: none;
      box-shadow: inset 4px 0 0 var(--banana);
      padding-left: 14px;
    }
    /* con JavaScript il menu parte chiuso; senza, resta sempre visibile */
    :global(html.js) .menu {
      display: inline-flex;
    }
    :global(html.js:not(.menu-open)) nav {
      display: none;
    }
  }
  /* telefoni: logo, tema e menu devono stare su una riga sola */
  @media (max-width: 420px) {
    .logo {
      font-size: 1.05rem;
      gap: 8px;
    }
    .logo :global(svg) {
      width: 34px;
      height: 34px;
    }
    .menu {
      padding: 0;
      width: 40px;
      justify-content: center;
    }
    .menu span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .site-footer {
    margin-top: 64px;
    padding: 28px 0 40px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .responsible {
    max-width: 80ch;
  }
  .credits {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
  }
</style>
