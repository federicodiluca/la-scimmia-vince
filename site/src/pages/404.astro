---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/format";
---

<Layout noindex title="Pagina non trovata" description="Questa pagina non esiste. Torna alla home de La Scimmia Vince o guarda le statistiche dei 90 numeri del SuperEnalotto.">
  <div class="nf">
    <Icon name="banana" size={96} />
    <h1>Questa pagina è uscita dall'urna</h1>
    <p class="lead">Anzi, non c'è mai entrata. Prova dalla <a href={url()}>home</a> o dai <a href={url("numeri")}>90 numeri</a>.</p>
    <p class="odds muted">
      Probabilità di trovarla riprovando a caso: più o meno le stesse del 6, cioè 1 su 622.614.630.
      La scimmia, per la cronaca, ci sta ancora provando.
    </p>
  </div>
</Layout>

<style>
  .nf {
    text-align: center;
    padding: 40px 0;
  }
  .nf .lead {
    margin: 0 auto;
  }
  .nf .odds {
    max-width: 34em;
    margin: 1.5em auto 0;
    font-size: 0.9em;
  }
</style>
