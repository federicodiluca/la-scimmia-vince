---
// Icone a tema: tutte disegnate su viewBox 64×64, decorative (aria-hidden) di default.
interface Props {
  name: "monkey" | "banana" | "die" | "lens" | "calendar";
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 32, label, class: cls } = Astro.props;
const a11y: Record<string, string> = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg viewBox="0 0 64 64" width={size} height={size} class:list={["icon", cls]} {...a11y}>
  {
    name === "monkey" && (
      <>
        <g fill="#7a4a2a">
          <circle cx="11" cy="34" r="9" />
          <circle cx="53" cy="34" r="9" />
          <circle cx="32" cy="35" r="21" />
        </g>
        <g fill="#f0cfa0">
          <circle cx="11" cy="34" r="5" />
          <circle cx="53" cy="34" r="5" />
          <circle cx="25" cy="34" r="9" />
          <circle cx="39" cy="34" r="9" />
          <ellipse cx="32" cy="45" rx="14" ry="10.5" />
        </g>
        <g fill="#1e1a16">
          <circle cx="26" cy="33" r="3" />
          <circle cx="38" cy="33" r="3" />
          <ellipse cx="29.5" cy="41" rx="1.4" ry="1" />
          <ellipse cx="34.5" cy="41" rx="1.4" ry="1" />
        </g>
        <g fill="#fff">
          <circle cx="27" cy="32" r="1" />
          <circle cx="39" cy="32" r="1" />
        </g>
        <path d="M25 46 Q32 53 39 46" fill="none" stroke="#1e1a16" stroke-width="2.4" stroke-linecap="round" />
        <path
          d="M20 16 L21 5 L27 11 L32 3 L37 11 L43 5 L44 16 Z"
          fill="#f2c230"
          stroke="#b8860b"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    name === "banana" && (
      <>
        <path
          d="M12 14 C10 36 24 54 50 52 C54 52 56 49 53 47 C34 46 22 34 20 16 C19 11 13 10 12 14 Z"
          fill="#f2c230"
          stroke="#b8860b"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path d="M17 20 C19 34 28 44 44 48" fill="none" stroke="#d9a514" stroke-width="2" stroke-linecap="round" />
        <path d="M11 10 L15 8 L17 13 L13 15 Z" fill="#5b4a1f" />
      </>
    )
  }
  {
    name === "die" && (
      <>
        <rect x="8" y="8" width="48" height="48" rx="11" fill="#fcfcfb" stroke="#1e1a16" stroke-width="3" />
        <g fill="#1e1a16">
          <circle cx="21" cy="21" r="4.5" />
          <circle cx="43" cy="21" r="4.5" />
          <circle cx="32" cy="32" r="4.5" />
          <circle cx="21" cy="43" r="4.5" />
          <circle cx="43" cy="43" r="4.5" />
        </g>
      </>
    )
  }
  {
    name === "lens" && (
      <>
        <circle cx="27" cy="27" r="17" fill="#cde2fb" stroke="#1e1a16" stroke-width="4" />
        <path d="M40 40 L56 56" stroke="#7a4a2a" stroke-width="8" stroke-linecap="round" />
        <path d="M19 22 Q22 16 29 15" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "calendar" && (
      <>
        <rect x="8" y="12" width="48" height="44" rx="8" fill="#fcfcfb" stroke="#1e1a16" stroke-width="3" />
        <path d="M8 24 H56" stroke="#1e1a16" stroke-width="3" />
        <path d="M20 6 V16 M44 6 V16" stroke="#1e1a16" stroke-width="4" stroke-linecap="round" />
        <circle cx="32" cy="40" r="7" fill="#f2c230" stroke="#b8860b" stroke-width="2" />
      </>
    )
  }
</svg>

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
    flex: none;
  }
</style>
