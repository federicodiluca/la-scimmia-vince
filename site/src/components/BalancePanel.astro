---
// Un pannello dei piccoli multipli: saldo cumulato di una strategia contro la fascia delle
// scimmie (5°-95° percentile) e la loro mediana. Stesso dominio y in tutti i pannelli.
import { eur, int } from "../lib/format";
import { niceStep } from "../lib/svg";

interface Props {
  title: string;
  dates: string[];
  values: number[];
  band: { low: number[]; mid: number[]; high: number[] };
  domain: [number, number];
  id: string;
}
const { title, dates, values, band, domain, id } = Astro.props;

const W = 360;
const H = 200;
const m = { l: 56, r: 10, t: 10, b: 24 };
const pw = W - m.l - m.r;
const ph = H - m.t - m.b;
const [lo, hi] = domain;
const x = (i: number) => m.l + (i / (dates.length - 1)) * pw;
const y = (v: number) => m.t + ((hi - v) / (hi - lo)) * ph;
const line = (vs: number[]) => vs.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
const area =
  band.high.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ") +
  band.low
    .map((v, i) => [i, v] as const)
    .reverse()
    .map(([i, v]) => `L${x(i).toFixed(1)},${y(v).toFixed(1)}`)
    .join(" ") +
  " Z";
const step = niceStep(hi - lo, 3);
const ticks: number[] = [];
for (let t = Math.ceil(lo / step) * step; t <= hi; t += step) ticks.push(t);
const years = [...new Set(dates.map((d) => d.slice(0, 4)))];
const yearTicks = years.filter((yr) => Number(yr) % 4 === 0).map((yr) => ({ yr, i: dates.findIndex((d) => d.startsWith(yr)) }));
const last = values.length - 1;
// zone di passaggio per il tooltip: una ogni ~5 punti
const zoneStep = Math.max(1, Math.round(dates.length / 48));
const zones = dates.map((_, i) => i).filter((i) => i % zoneStep === 0);
---

<figure class="panel">
  <figcaption>{title}</figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>
      {title}: saldo finale {eur(values[last]!)}; metà delle scimmie finisce intorno a {eur(band.mid[last]!)}
    </title>
    {
      ticks.map((t) => (
        <g>
          <line class={t === 0 ? "zero" : "grid"} x1={m.l} x2={W - m.r} y1={y(t)} y2={y(t)} />
          <text class="tick" x={m.l - 6} y={y(t)} dy="0.32em" text-anchor="end">
            {t === 0 ? "0 €" : `${t > 0 ? "+" : "−"}${int(Math.abs(t))} €`}
          </text>
        </g>
      ))
    }
    {
      yearTicks.map(({ yr, i }) => (
        <text class="tick" x={x(i)} y={H - 6} text-anchor="middle">
          {yr}
        </text>
      ))
    }
    <path class="band" d={area}></path>
    <path class="mid" d={line(band.mid)}></path>
    <path class="series" d={line(values)}></path>
    <circle class="end" cx={x(last)} cy={y(values[last]!)} r="4"></circle>
    {
      zones.map((i, k) => {
        const next = zones[k + 1] ?? dates.length - 1;
        return (
          <rect
            class="hit"
            x={x(i)}
            width={Math.max(1, x(next) - x(i))}
            y={m.t}
            height={ph}
            data-tip={`${dates[i]}: ${title.toLowerCase()} ${eur(values[i]!)} · scimmia media ${eur(band.mid[i]!)}`}
          />
        );
      })
    }
  </svg>
</figure>

<style>
  .panel {
    margin: 0;
  }
  figcaption {
    font-weight: 650;
    margin-bottom: 4px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid {
    stroke: var(--grid);
  }
  .zero {
    stroke: var(--axis);
  }
  .tick {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .band {
    fill: var(--band);
  }
  .mid {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .series {
    fill: none;
    stroke: var(--series-1);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .end {
    fill: var(--series-1);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .hit {
    fill: transparent;
  }
  .hit:hover {
    fill: color-mix(in srgb, var(--series-1) 8%, transparent);
  }
</style>
